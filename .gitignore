# ============================================================
# AI Meeting Intelligence System — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.pyo

# Environment
.env
.env.local
.env.*.local
!.env.example

# Database
*.db
*.sqlite
*.sqlite3

# Alembic (keep versions, ignore __pycache__)
backend/alembic/versions/__pycache__/

# Storage (audio files, generated artifacts — never commit)
backend/storage/audio/
backend/storage/artifacts/
backend/storage/imports/

# Node
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vite / React build
frontend/dist/
frontend/.vite/

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / Linting
.ruff_cache/

# pyannote / ML model caches
.cache/
backend/.cache/

# Keep storage structure but not contents
!backend/storage/.gitkeep
!backend/storage/audio/.gitkeep
!backend/storage/artifacts/.gitkeep
!backend/storage/imports/.gitkeep
